{
  "crons": [
    {
      "path": "/api/veille-appels-offres",
      "schedule": "30 5 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/l",
      "destination": "/api/lien"
    },
    {
      "source": "/o",
      "destination": "/api/ouverture"
    },
    {
      "source": "/d",
      "destination": "/api/desabonnement"
    }
  ],
  "functions": {
    "api/prix-travaux-analyser-devis.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/chantiers",
      "destination": "/chantiers.html",
      "permanent": false
    },
    {
      "source": "/maisonauchaud",
      "destination": "/maison-au-chaud.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}